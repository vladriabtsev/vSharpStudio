<UserControl x:Class="vSharpStudio.Views.EditorRoleSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:Converters="clr-namespace:vSharpStudio.wpf.Converters;assembly=vSharpStudio.wpf" 
             xmlns:vc="clr-namespace:vSharpStudio.Controls"
             xmlns:std="clr-namespace:ViewModelBase;assembly=vSharpStudio.std"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" 
             xmlns:common="clr-namespace:vSharpStudio.common;assembly=vSharpStudio.common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:vSharpStudio.Views" 
             xmlns:viewmodels="clr-namespace:vSharpStudio.ViewModels" 
             xmlns:bvm="clr-namespace:vSharpStudio.vm.ViewModels;assembly=vSharpStudio.vm"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <!--d:DataContext="{d:DesignInstance Type=viewmodels:EditorRoleColumnVm}"-->
    <UserControl.Resources>
        <Converters:ConverterIconNameToResource x:Key="ConverterIconNameToResource"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="55" />
            <ColumnDefinition Width="40" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <ContentControl Grid.Column="0">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type bvm:RoleCatalogsSettings}">
                        <StackPanel Orientation="Horizontal" d:DataContext="{d:DesignInstance Type=bvm:RoleCatalogsSettingsWithNull}">
                            <CheckBox IsThreeState="True" IsChecked="{Binding CanPrint, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Template="{Binding Catalog.IconName, Converter={StaticResource ConverterIconNameToResource}, Mode=OneWay}" />
                                    <TextBlock>Print</TextBlock>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsThreeState="True" Content="View" IsChecked="{Binding CanView, Mode=TwoWay}">
                            </CheckBox>
                            <CheckBox IsThreeState="True" Content="Print" IsChecked="{Binding CanViewFields, Mode=TwoWay}">
                            </CheckBox>
                            <CheckBox IsThreeState="True" Content="Print" IsChecked="{Binding CanViewDetails, Mode=TwoWay}">
                            </CheckBox>
                            <CheckBox IsThreeState="True" Content="Print" IsChecked="{Binding CanEdit, Mode=TwoWay}">
                            </CheckBox>
                            <CheckBox IsThreeState="True" Content="Print" IsChecked="{Binding CanEditFields, Mode=TwoWay}">
                            </CheckBox>
                            <CheckBox IsThreeState="True" Content="Print" IsChecked="{Binding CanEditDetails, Mode=TwoWay}">
                            </CheckBox>
                            <CheckBox IsThreeState="True" Content="Print" IsChecked="{Binding CanEditItems, Mode=TwoWay}">
                            </CheckBox>
                            <CheckBox IsThreeState="True" Content="Print" IsChecked="{Binding CanEditFolders, Mode=TwoWay}">
                            </CheckBox>
                            <CheckBox IsThreeState="True" Content="Print" IsChecked="{Binding CanMoveItems, Mode=TwoWay}">
                            </CheckBox>
                            <CheckBox IsThreeState="True" Content="Print" IsChecked="{Binding CanMoveFolders, Mode=TwoWay}">
                            </CheckBox>
                            <CheckBox IsThreeState="True" Content="Print" IsChecked="{Binding CanMarkDel, Mode=TwoWay}">
                            </CheckBox>
                        </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type bvm:Document}">
                        <local:EditorDocument />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type bvm:Form}">
                        <local:EditorForm />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type bvm:Journal}">
                        <local:EditorJournal />
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <ContentControl Grid.Column="0">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Template" Value="{StaticResource iconRedirectedRequest}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCustomPrintAccess}" Value="True">
                                <Setter Property="Template" Value="{StaticResource iconCustomActionEditor}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <xctk:DropDownButton Name="ddbPrint" Grid.Column="1" Width="17">
                <xctk:DropDownButton.DropDownContent>
                    <ComboBox MinWidth="150" ItemsSource="{Binding ListPrintAccess}" SelectedValue="{Binding SelectedPrintAccess}" SelectedValuePath="Value">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </xctk:DropDownButton.DropDownContent>
            </xctk:DropDownButton>
            <TextBlock Grid.Column="2" Text="{Binding PrintAccessStr}" />
        </Grid>
    </Grid>
</UserControl>
